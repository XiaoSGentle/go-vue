{{ $Table := .Table -}} {{ $Columns := .Columns -}}
<template>
  <div>
    <n-card title="" :bordered="false" class="h-full rounded-8px shadow-sm">
      <div class="flex-col h-full">
        <n-space class="pb-12px" justify="space-between">
          <n-space>
            <n-button type="primary" @click="handleAddTable">
              <icon-ic-round-plus class="mr-4px text-20px" />
              添加
            </n-button>
            <n-button type="error" @click="handleDeleteTable">
              <icon-ic-round-delete class="mr-4px text-20px" />
              删除
            </n-button>
          </n-space>
          <n-space align="center" :size="18">
            <n-button size="small" type="primary" @click="initTableData">
              <icon-mdi-refresh
                class="mr-4px text-16px"
                :class="{ 'animate-spin': loading }"
              />
              刷新表格
            </n-button>
            <column-setting v-model:columns="dataColumns" />
          </n-space>
        </n-space>
        <n-data-table
          :loading="loading"
          :columns="dataColumns"
          :data="tableData"
          :row-key="rowKey"
          :on-update-checked-row-keys="handleCheckedRowKeysChange"
        />
      </div>
      <table-action-modal
        v-model:visible="visible"
        :type="modalType"
        :edit-data="editData"
        @update:visible="initTableData"
      />
      <template #footer>
        <n-pagination
          v-model:page="req{{ $Table.UpUpName }}PageParam.pageNum"
          v-model:page-size="req{{ $Table.UpUpName }}PageParam.pageSize"
          :item-count="totalCount"
          :on-update:page-size="handlerPageSizeChange"
          :on-update:page="handlerPageChange"
          show-quick-jumper
          show-size-picker
          :page-sizes="[10, 20, 30, 40]"
        />
      </template>
    </n-card>
  </div>
</template>

<script setup lang="tsx">
  import type { Ref } from 'vue';
  import { onMounted, ref } from 'vue';
  import type { DataTableColumns } from 'naive-ui';
  import { NIcon, NButton, NSpace } from 'naive-ui';
  import dayjs from 'dayjs';
  import { useLoading, useBoolean } from '@/hooks';
  import ColumnSetting from './components/column-setting.vue';
  import type { ModalType }, TableActionModal from './components/table-action-modal.vue';
  import { useIconRender } from '@/composables';
  import { fetch{{$Table.UpUpName}}List , del{{$Table.UpUpName}}ByIds } from '~/src/service';

  // 表格加载
  const { loading, startLoading, endLoading } = useLoading(false);

  // 定义表格数据
  const tableData = ref<{{ $Table.UpUpName -}}Management.Base{{ $Table.UpUpName }}[]>();

  // 定义数据总条数
  const totalCount = ref<number>(0);

  // 定义ICON 渲染组件
  const { iconRender } = useIconRender();

  // 定义查询数据(最初只有简单分页)
  const req{{ $Table.UpUpName }}PageParam = ref<{{ $Table.UpUpName -}}Management.Req{{ $Table.UpUpName }}PageParam>({
    pageNum: 1,
    pageSize: 10
  });

  // 页数大小发生改变
  const handlerPageSizeChange = (pageSize: number) => {
    req{{ $Table.UpUpName }}PageParam.value.pageSize = pageSize;
    initTableData();
  };
  const handlerPageChange = (pageNum: number) => {
    req{{ $Table.UpUpName }}PageParam.value.pageNum = pageNum;
    initTableData();
  };

  // 初始化table
  const initTableData = () => {
    startLoading();
    const { data,totalCount } = await fetch{{ $Table.UpUpName }}List(req{{ $Table.UpUpName }}PageParam.value);
    if (data && totalCount) {
      tableData.value = data.data;
      totalCount.value = totalCount
    }else{
      window.$message?.error('获取数据失败');
    }
    endLoading();
  };

  // 初始化表格
  onMounted(() => initTableData());

  // 定义修改框的可见性
  const { bool: visible, setTrue: openModal } = useBoolean();

  // 每行的key
  const rowKey = ref((row: {{ $Table.UpUpName -}}Management.AddOrUp{{ $Table.UpUpName }}Param) => row.uuid);

  //数据行被选中
  const checkedRowKeys = ref<(string | number)[]>();
  const handleCheckedRowKeysChange = (keys: Array<string | number>) => {
    checkedRowKeys.value = keys;
  };

  // 删除数据
  async function handleDeleteTable() {
    if (checkedRowKeys.value !== undefined && checkedRowKeys.value.length > 0) {
     const {data} = await del{{$Table.UpUpName}}ByIds(checkedRowKeys.value);
     if(data){
       window.$message?.success('删除成功');
       initTableData()
     }else{
       window.$message?.error('删除失败');
     }
    }
  }

  // 定义弹出框的方式
  const modalType = ref<ModalType>('add');
  function setModalType(type: ModalType) {
    modalType.value = type;
  }

  // 定义为添加
  function handleAddTable() {
    setModalType('add');
    openModal();
  }

  // 定义编辑的数据
  const editData = ref<{{ $Table.UpUpName -}}Management.AddOrUp{{ $Table.UpUpName }}Param | any>();

  // 设置编辑的数据
  function setEditData(data: {{ $Table.UpUpName }}Management.AddOrUp{{ $Table.UpUpName }}Param) {
    editData.value = data;
  }

  // 编辑按钮点击
  function handleEditTable(rowId: string) {
    const findItem = tableData.value?.find(item => item.uuid === rowId);
    if (findItem) {
      setEditData(findItem);
    }
    setModalType('edit');
    openModal();
  }

  // 定义数据表格数据
  const dataColumns: Ref<DataTableColumns<{{$Table.UpUpName}}Management.Base{{$Table.UpUpName}} | any>> = ref([
    {
      type: 'selection',
      align: 'center'
    },
    {{  range $index, $value := $Columns -}}
  	    {{- with $value -}}
            {{- if  .IsBase  }}
    {
      key:"{{- .ColumnLowUpName -}}",
      title:"{{- .ColumnComment -}}"
    },
            {{- end }}
        {{- end -}}
    {{- end }}
    {
      key: '-',
      title: '操作',
      align: 'center',
      render: row => {
        return (
          <NSpace justify={'center'}>
            <NButton circle={true} size={'small'} onClick={() => handleEditTable(row.uuid)}>
              <NIcon component={iconRender({ icon: 'material-symbols:edit-square' })()}></NIcon>
            </NButton>
          </NSpace>
        );
      }
    }
  ]);
</script>
