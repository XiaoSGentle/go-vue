//  AddOrUp{{$Table.UpUpName}} 更新或者修改
func ({{ $Table.LowUpName }}Service {{ $Table.UpUpName }}Service) AddOrUp{{$Table.UpUpName}}(addOrUp{{ $Table.UpUpName }}Param AddOrUp{{ $Table.UpUpName }}Param,c *gin.Context) (status bool, err error){
	{{ $Table.LowUpName }}Query := query.Use({{ $Table.LowUpName }}Service.db).{{ $Table.UpUpName }}
	var temp{{ $Table.UpUpName}} model.{{ $Table.UpUpName}}
	if err = copier.Copy(&temp{{ $Table.UpUpName}}, addOrUp{{ $Table.UpUpName }}Param); err != nil {
		return false, err
	}
	// 有UUID 判定为更新
	if addOrUp{{ $Table.UpUpName }}Param.UUID != "" {
        operator_info_bind.AddUpInfo(&temp{{ $Table.UpUpName}}, operator_info_bind.UP, c)
		updates, err := {{ $Table.LowUpName }}Query.Where({{ $Table.LowUpName }}Query.UUID.Eq(addOrUp{{ $Table.UpUpName }}Param.UUID)).Updates(temp{{ $Table.UpUpName}})
		// 影响行数为0 或者有错误
		if err != nil || updates.RowsAffected < 1 {
			return false, err
		}
        return true, nil
	} else {
		// 没有UUID 判断为 新增
		temp{{ $Table.UpUpName}}.UUID = variable.SnowFlake.GetStringUuid()
		operator_info_bind.AddUpInfo(&temp{{ $Table.UpUpName}}, operator_info_bind.ADD, c)
		err := {{ $Table.LowUpName }}Query .Save(&temp{{ $Table.UpUpName}})
		if err != nil {
			return false, err
		}
		return true, nil
	}
}

