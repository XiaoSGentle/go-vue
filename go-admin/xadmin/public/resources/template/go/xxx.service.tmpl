// Del{{ $Table.UpUpName }}ByUuids 根据UUIDs删除
func ({{ $Table.LowUpName }}Service {{ $Table.UpUpName }}Service) Del{{ $Table.UpUpName }}ByUuids(delete{{ $Table.UpUpName }}UuidsParam Delete{{ $Table.UpUpName }}UuidsParam,c *gin.Context) (status bool, err error){
	{{ $Table.LowUpName }}Query := query.Use({{ $Table.LowUpName }}Service.db).{{ $Table.UpUpName }}
	idArray := strings.Split(delete{{ $Table.UpUpName }}UuidsParam.Ids, ",")
	info, err := {{ $Table.LowUpName }}Query.Where({{ $Table.LowUpName }}Query.UUID.In(idArray...)).Delete()
